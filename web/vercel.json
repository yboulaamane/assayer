{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/api/:name(route|plan|tailor)", "destination": "https://insilicobench.com/tools/assayer/api/:name", "statusCode": 308 },
    { "source": "/:file(catalog.json|catalog-core.json|catalog-registry.json)", "destination": "https://insilicobench.com/tools/assayer/:file", "statusCode": 301 },
    { "source": "/details/:path*", "destination": "https://insilicobench.com/tools/assayer/details/:path*", "statusCode": 301 },
    { "source": "/", "destination": "https://insilicobench.com/tools/assayer/", "statusCode": 301 },
    { "source": "/:path*", "destination": "https://insilicobench.com/tools/assayer/", "statusCode": 301 }
  ]
}
